# ===================================
# O'quv Markaz - Production Sozlamalari
# ===================================
# Bu faylni .env ga nusxalang va qiymatlarni o'zgartiring:
# cp .env.production .env

# Database
DB_PASSWORD=your-secure-db-password-here

# Backend Security
SECRET_KEY=your-very-long-random-secret-key-here
ADMIN_PASSWORD=YourSecureAdminPassword2026!

# Telegram Bot (@BotFather dan oling)
TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFFggHHiiJJkkLLmmNNoo

# Click Payment (ixtiyoriy)
CLICK_SECRET_KEY=your-click-secret
CLICK_SERVICE_ID=your-service-id

# CORS - Frontend domeni
EXTRA_CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Port (default: 80)
APP_PORT=80
